# Interactive Brokers — paper by default
IBKR__HOST=127.0.0.1
IBKR__PORT=7497
IBKR__CLIENT_ID=1
IBKR__ACCOUNT=

# Telegram alerts
TELEGRAM__BOT_TOKEN=
TELEGRAM__CHAT_ID=

# Earnings data
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=

# Options chains (Phase 2+)
POLYGON_API_KEY=
THETADATA_API_KEY=

# Bot mode: dev | paper | live
VOLSCOPE_ENV=dev

# Heartbeat (optional — empty = disabled)
HEALTHCHECKS_URL=

# Email alerts (legacy)
VOLSCOPE_SMTP_PASS=

# DB override (default: ~/Library/Application Support/VolScope/)
# VOLSCOPE_DATA_DIR=
