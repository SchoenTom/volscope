     Schema-Erweiterung\
\
     -- In VolScopeDB._create_tables (volscope/data/database.py)\
     CREATE TABLE IF NOT EXISTS sector_daily (\
         sector VARCHAR NOT NULL,\
         date DATE NOT NULL,\
         median_iv DOUBLE,\
         median_perc DOUBLE,\
         median_hv DOUBLE,\
         mean_pcr DOUBLE,\
         total_oi BIGINT,\
         total_vol BIGINT,\
         n_tickers INTEGER,\
         regime VARCHAR,        -- HOT / COLD / NEUTRAL\
         regime_z DOUBLE,\
         PRIMARY KEY (sector, date)\
     )\
\
     Analytics-Funktionen (sector_rotation.py)\
\
     1. compute_sector_aggregates(daily_vol_df) \'97 Gruppierung nach (sector, date), Median IV/Perc/HV, Mean PCR, Total OI/Vol\
     2. compute_sector_momentum(agg, windows=[5,10,21]) \'97 Rolling Momentum: perc_delta, iv_momentum, oi_momentum pro Window\
     3. classify_sector_regime(agg, lookback=252) \'97 HOT/COLD/NEUTRAL via z-score (reuse vol_regime Pattern aus vol_metrics.py), plus HEATING/COOLING/STABLE Trend\
     4. compute_rotation_matrix(regimes, lag=21) \'97 Markov-\'e4hnliche Transition-Probabilities: "Wenn Energy HOT wird, welcher Sektor folgt historisch innerhalb 21 Tagen?"\
     5. get_current_rotation_snapshot(regimes, matrix) \'97 Identifiziert aktuell HEATING Sektoren + predicts "who's next"\
\
     UI: Rotation Page\
\
     - Sektor-Heatmap: Plotly heatmap, y=Sektoren, x=Datum, Farbe=median_perc (gr\'fcn=cheap, rot=rich). Toggle 3M/6M/1Y\
     - Regime-Strip: Jeder Sektor mit aktuellem Regime-Badge + Trend-Pfeil, sortiert nach Momentum\
     - Rotation-Predictions: "Energy heizt auf \uc0\u8594  Industrials folgt typischerweise in ~15d (68% Wahrscheinlichkeit)"\
     - Momentum-Tabelle: sortierbar, alle Sektoren\
